# Server-side only — never exposed to the browser.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Public — used by the browser to embed the real Cal.com booking flow.
# Format: "your-cal-username/your-event-slug"
# Create a free account at https://cal.com, create an event type (e.g. "hexcoded-demo"),
# and put "username/hexcoded-demo" here.
NEXT_PUBLIC_CAL_LINK=

# Public — used for absolute URLs in SEO/Open Graph metadata. Set this to your
# deployed URL once you have it (e.g. https://hexcoded.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
